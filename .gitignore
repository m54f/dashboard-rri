```php
<?php
session_start();
include 'koneksi.php';

// Cek apakah pengguna sudah login dan memiliki role petugas
if (!isset($_SESSION['username']) || $_SESSION['role'] !== 'petugas') {
    header("Location: login.php");
    exit();
}

// Ambil data buku dari database
$query = "SELECT * FROM buku";
$result = mysqli_query($koneksi, $query);
$buku_list = mysqli_fetch_all($result, MYSQLI_ASSOC);

// Ambil data peminjaman yang sedang aktif
$peminjaman_query = "SELECT p.id_peminjaman, p.tanggal_peminjaman, p.tanggal_pengembalian, p.status, u.nama AS nama_user, b.judul AS judul_buku 
                     FROM peminjaman p 
                     JOIN user u ON p.id_user = u.id_user 
                     JOIN buku b ON p.id_buku = b.id_buku 
                     WHERE p.status = 'dipinjam'";
$peminjaman_result = mysqli_query($koneksi, $peminjaman_query);
$peminjaman_list = mysqli_fetch_all($peminjaman_result, MYSQLI_ASSOC);
?>

