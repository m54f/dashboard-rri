        <h2>Peminjaman Aktif</h2>
        <?php if (empty($peminjaman_list)): ?>
            <p>Tidak ada peminjaman aktif saat ini.</p>
        <?php else: ?>
        <table>
            <tr>
                <th>ID Peminjaman</th>
                <th>Nama Peminjam</th>
                <th>Judul Buku</th>
                <th>Tanggal Pinjam</th>
                <th>Tanggal Kembali</th>
                <th>Status</th>
                <th>Aksi</th>
            </tr>
            <?php foreach ($peminjaman_list as $peminjaman): ?>
            <tr>
                <td><?php echo htmlspecialchars($peminjaman['id_peminjaman']); ?></td>
                <td><?php echo htmlspecialchars($peminjaman['nama_user']); ?></td>
                <td><?php echo htmlspecialchars($peminjaman['judul_buku']); ?></td>
                <td><?php echo htmlspecialchars($peminjaman['tanggal_peminjaman']); ?></td>
                <td><?php echo htmlspecialchars($peminjaman['tanggal_pengembalian']); ?></td>
                <td><?php echo htmlspecialchars($peminjaman['status']); ?></td>
                <td>
                    <form method="POST" action="konfirmasi_pengembalian.php" class="form-konfirmasi" onsubmit="return confirm('Yakin ingin mengkonfirmasi pengembalian?');">
                        <input type="hidden" name="id_peminjaman" value="<?php echo $peminjaman['id_peminjaman']; ?>">
                        <input type="submit" value="Konfirmasi Kembali">
                    </form>
                </td>
            </tr>
            <?php endforeach; ?>
        </table>
        <?php endif; ?>

        <br>
        <a href="tambah_buku.php" class="btn">Tambah Buku Baru</a>
